%{
#include "common.h"
#include <vector>
#include <string>
#include "ast.h"
#include "parser.hpp" // Generated by Bison (since we specified output to Parser in CMake)

// std::strdup is used to duplicate the matched string into the heap
// so the parser can safely access it after the lexer moves on.
#include <cstring>
%}

/* Tell Flex we only are reading one file */
%option noyywrap



/* Regular expressions for our tokens */
DIGIT       [0-9]+
IDENTIFIER  [a-zA-Z_][a-zA-Z0-9_]*
WHITESPACE  [ \t\r\n]+


%%

"//".*      { /* Ignore single-line comments */ }


"func"      { return T_FUNC; }
"return"    { return T_RETURN; }
"if"        { return T_IF; }
"while"     { return T_WHILE; }
"print"     { return T_PRINT; }

"+"         { return T_PLUS; }
"-"         { return T_MINUS; }
"*"         { return T_MUL; }
"/"         { return T_DIV; }
"%"         { return T_MOD; }

"<"         { return T_LESS; }
">"         { return T_GREATER; }
"=="        { return T_EQUALS; }
"="         { return T_ASSIGN; }

"("         { return T_LPAREN; }
")"         { return T_RPAREN; }
"{"         { return T_LBRACE; }
"}"         { return T_RBRACE; }
","         { return T_COMMA; }
";"         { return T_SEMICOLON; }

{DIGIT} {
    /* 
     * We matched an integer. We must convert the string yytext into an int 
     * and store it in yylval.int_val so the parser can retrieve it!
     */
    yylval.int_val = std::stoi(yytext);
    return T_INT;
}

{IDENTIFIER} {
    /*
     * We matched an identifier. We must allocate heap memory and copy yytext 
     * into it, because yytext is a temporary buffer owned by Flex.
     * The parser will take ownership of this memory and free it later.
     */
    yylval.str_val = strdup(yytext);
    return T_IDENTIFIER;
}

{WHITESPACE} { /* Ignore whitespace completely */ }

. {
    std::cerr << "Unknown character: " << yytext << std::endl;
}

%%
